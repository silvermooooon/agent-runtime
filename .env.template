# Copy to .env, edit, then run: uv run --env-file .env python examples/openai_responses.py
# SDK reads the process environment; it does not search for or automatically load .env files.
# Blank optional values are ignored. Explicit constructor/request values take precedence.

# Default provider / protocol. Responses is the default for the openai provider.
AGENT_PROVIDER=openai
AGENT_API=openai-responses
# Default model. Explicit model / deployment names still override this value.
AGENT_MODEL=gpt-6-luna

# Provider credentials and endpoints (base URL includes /v1, not /responses).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# HTTP per-operation timeout in seconds; must be positive. Default: 120.
AGENT_TIMEOUT_SECONDS=120

# Optional model parameters. They still pass through the same filtering/rewrite pipeline.
# Blank max tokens uses known model metadata, or a 4096 output cap for unregistered models.
AGENT_MAX_TOKENS=
AGENT_TEMPERATURE=
# off/none, minimal, low, medium, high, xhigh, max; blank preserves the provider default.
AGENT_REASONING=

# Optional local skill catalog: <directory>/<skill-name>/SKILL.md.
# Used only when explicitly constructing LocalSkillStore/create_skill_tools.
# Relative paths are resolved from the process working directory.
AGENT_SKILLS_DIR=./skills

# Optional PostgreSQL Session. Install: uv sync --extra postgres
# Example: postgresql://user:password@localhost:5432/agent_runtime?sslmode=require
AGENT_DB_URL=
AGENT_DB_POOL_MIN_SIZE=1
AGENT_DB_POOL_MAX_SIZE=10
AGENT_DB_CONNECT_TIMEOUT_SECONDS=10
AGENT_DB_STATEMENT_TIMEOUT_SECONDS=30

# Cold archives. Install: uv sync --extra s3
# Host schedules archival and excludes active writers for the target session.
AGENT_ARCHIVE_ENABLED=false
AGENT_ARCHIVE_AFTER_DAYS=30
AGENT_ARCHIVE_MAX_EVENTS=10000
AGENT_ARCHIVE_TARGET_BYTES=33554432
AGENT_ARCHIVE_S3_URI=
AWS_REGION=
# Required when archives enabled: arn:aws:kms:region:account:key/key-id
AGENT_ARCHIVE_KMS_KEY_ARN=
# AWS credential chain; prefer an IAM role in production. No credentials in event logs.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Integration tests only; never point this at production (tests create an isolated schema).
AGENT_TEST_DB_URL=
